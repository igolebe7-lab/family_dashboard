[Unit]
Description=FamilyTime HTTPS and static PWA
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/etc/familytime/public.env
Environment=GOMEMLIMIT=48MiB
Environment=GOMAXPROCS=1
ExecStart=/usr/bin/caddy run --environ --config /etc/familytime/Caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/familytime/Caddyfile --force
Restart=on-failure
RestartSec=10
MemoryHigh=64M
MemoryMax=96M
CPUWeight=20
CPUQuota=30%
Nice=10
TasksMax=64
LimitNOFILE=4096
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=familytime-caddy
Environment=XDG_DATA_HOME=/var/lib/familytime-caddy
Environment=XDG_CONFIG_HOME=/var/lib/familytime-caddy
ReadWritePaths=/var/lib/familytime-caddy
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
