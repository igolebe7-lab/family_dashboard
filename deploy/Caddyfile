{
	admin 127.0.0.1:2019
	auto_https off
	default_sni {$FAMILYTIME_PUBLIC_IP}
	servers {
		protocols h1 h2
	}
}

http://{$FAMILYTIME_PUBLIC_IP} {
	handle /.well-known/acme-challenge/* {
		root * /var/lib/familytime-acme
		file_server
	}
	handle {
		redir https://{$FAMILYTIME_PUBLIC_IP}{uri} permanent
	}
}

https://{$FAMILYTIME_PUBLIC_IP} {
	tls /etc/familytime/tls/current/fullchain.pem /etc/familytime/tls/current/privkey.pem
	encode zstd gzip
	@maintenance file {
		root /var/lib/familytime-maintenance
		try_files active
	}
	respond @maintenance "FamilyTime is updating. Please retry shortly." 503
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	@admin path /_ /_/* /api/collections/_superusers /api/collections/_superusers/* /api/settings /api/settings/* /api/backups /api/backups/*
	handle @admin {
		respond 404
	}
	@app_api path_regexp app_api ^/(api/(collections/(users|families|family_members|items|item_occurrences|day_annotations|item_comments|item_activity|notifications|invitations|chore_templates)(/|$)|familytime/|realtime/?$|health/?$|files/)|familytime/invitations/(preview|accept)$)
	handle @app_api {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}
	handle /api/* {
		respond 404
	}
	handle /_app/immutable/* {
		root * /opt/familytime/current/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /opt/familytime/current/web
		header Cache-Control no-cache
		try_files {path} /200.html
		file_server
	}
}
