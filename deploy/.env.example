# Copy values to separate root-owned files; never ship real secrets in a release.
# /etc/familytime/public.env (root:caddy, 0640)
FAMILYTIME_PUBLIC_IP=147.45.136.245

# /etc/familytime/backend.env (root:familytime, 0640)
# Generate once with: pocketbase vapid-keygen
FAMILYTIME_VAPID_PUBLIC_KEY=
FAMILYTIME_VAPID_PRIVATE_KEY=
# Set a real monitored contact before enabling Web Push.
FAMILYTIME_VAPID_SUBJECT=
